function _custom_feedback_validate(array &$form, FormStateInterface $form_state){
  $titlevalue = $form_state->getValue('title');
  $title = trim($titlevalue['0']['value']);
  $field_comment_value = $form_state->getValue('body');
  $field_feedback_query_description = trim($field_comment_value['0']['value']);
  $field_contact_no_feedback_value = $form_state->getValue('field_contact_number');
  $field_feedback_contact_number = trim($field_contact_no_feedback_value['0']['value']);  
  $titleLength = strlen($title);
  //$field_subjecte_value = $form_state->getValue('field_subject_feedback');
  //$field_subjecte_type = trim($field_subjecte_value['0']['value']);
  //$field_email = $form_state->getValue('field_email_id');
  //$f_email = trim($field_email['0']['value']);
  $current_ip_address = Drupal::request()->getClientIp();
  $connection = \Drupal::database();
  $date = REQUEST_TIME; //strtotime(date("Y-m-d")); // CURRENT TIME STAMP
  $sDate = 86400; // 60*60*24 //timestamp("+1 day"); // day after original date
  $eDate = 86400; // 60*60*24 strtotime("-1 day"); // day after original date
  $startDate = ($date + $sDate);
  $endtDate = ($date - $eDate);
  $connection = \Drupal::database();
  //echo "<br/>==>".($date + 600);
  //echo "<br/>==>".($date - 600);

  $query = $connection->query("SELECT node_field_data.created AS node_field_data_created, node_field_data.nid AS nid
    FROM
    {node_field_data} node_field_data
    WHERE (node_field_data.type IN ('feedback')) AND ((node_field_data.created <= $date+600)) AND ((node_field_data.created >= $date-600))
    ORDER BY node_field_data_created DESC
    LIMIT 1 OFFSET 0");
  $result = $query->fetchAll();
  if(!empty($result)){
      $form_state->setErrorByName('title', t('We have received your feedback recently, please wait and submit after sometime.'));
  }
  /* if($f_email != ""){
      if (!preg_match("/^[_a-z0-9-]+(\.[_a-z0-9-]+)*@[a-z0-9-]+(\.[a-z0-9-]+)*(\.[a-z]{2,4})$/", $f_email)) {
          $form_state->setErrorByName('field_email_id', t('Please enter valid email address.'));
      }
  } */
  if($title != ""){
      if (!preg_match("/^[a-zA-Z ]+$/", $title)) {
          $form_state->setErrorByName('title', t('Please enter valid content for Name.'));
      }
      if($titleLength < 3){
          $form_state->setErrorByName('title', t('Please enter minimum 3 character for Name.'));
      }
  }
  if ($field_feedback_contact_number != '') {
      if (!preg_match("/^[0-9 ]+$/", $field_feedback_contact_number)) {
          $form_state->setErrorByName('field_contact_number', t('Please enter only digit for Contact No.'));
      }
      $mopbLength = strlen($field_feedback_contact_number);
      if($mopbLength > 11 || $mopbLength < 10){
          $form_state->setErrorByName('field_contact_number', t('Please enter maximum 11 and minimum 10 digits for Contact No.'));
      }
  }
 
  if ($field_feedback_query_description != '') {
      if (!preg_match("/^[a-zA-Z0-9 ]+$/", $field_feedback_query_description)) {
          $form_state->setErrorByName('body', t('Please enter valid content for Feedback/Query Description.'));
      }
  }
  
}
function _custom_enquiry_validate(array &$form, FormStateInterface $form_state){
  $titlevalue = $form_state->getValue('title');
  $title = trim($titlevalue['0']['value']);
  $field_comment_value = $form_state->getValue('body');
  $field_feedback_query_description = trim($field_comment_value['0']['value']);
  $field_contact_no_feedback_value = $form_state->getValue('field_online_contact_number');
  $field_feedback_contact_number = trim($field_contact_no_feedback_value['0']['value']);  
  $titleLength = strlen($title);
  //$field_subjecte_value = $form_state->getValue('field_subject_feedback');
  //$field_subjecte_type = trim($field_subjecte_value['0']['value']);
  //$field_email = $form_state->getValue('field_email_id');
  //$f_email = trim($field_email['0']['value']);
  $current_ip_address = Drupal::request()->getClientIp();
  $connection = \Drupal::database();
  $date = REQUEST_TIME; //strtotime(date("Y-m-d")); // CURRENT TIME STAMP
  $sDate = 86400; // 60*60*24 //timestamp("+1 day"); // day after original date
  $eDate = 86400; // 60*60*24 strtotime("-1 day"); // day after original date
  $startDate = ($date + $sDate);
  $endtDate = ($date - $eDate);
  $connection = \Drupal::database();
  //echo "<br/>==>".($date + 600);
  //echo "<br/>==>".($date - 600);
  
  $query = $connection->query("SELECT node_field_data.created AS node_field_data_created, node_field_data.nid AS nid
    FROM
    {node_field_data} node_field_data
    WHERE (node_field_data.type IN ('online_enquiry')) AND ((node_field_data.created <= $date+600)) AND ((node_field_data.created >= $date-600))
    ORDER BY node_field_data_created DESC
    LIMIT 1 OFFSET 0");
  $result = $query->fetchAll();
  if(!empty($result)){
      $form_state->setErrorByName('title', t('We have received your online enquiry recently, please wait and submit after sometime.'));
  }
  /* if($f_email != ""){
      if (!preg_match("/^[_a-z0-9-]+(\.[_a-z0-9-]+)*@[a-z0-9-]+(\.[a-z0-9-]+)*(\.[a-z]{2,4})$/", $f_email)) {
          $form_state->setErrorByName('field_email_id', t('Please enter valid email address.'));
      }
  } */
  if($title != ""){
      if (!preg_match("/^[a-zA-Z ]+$/", $title)) {
          $form_state->setErrorByName('title', t('Please enter valid content for Name.'));
      }
      if($titleLength < 3){
          $form_state->setErrorByName('title', t('Please enter minimum 3 character for Name.'));
      }
  }
  if ($field_feedback_contact_number != '') {
      if (!preg_match("/^[0-9 ]+$/", $field_feedback_contact_number)) {
          $form_state->setErrorByName('field_contact_number', t('Please enter only digit for Contact No.'));
      }
      $mopbLength = strlen($field_feedback_contact_number);
      if($mopbLength > 11 || $mopbLength < 10){
          $form_state->setErrorByName('field_contact_number', t('Please enter maximum 11 and minimum 10 digits for Contact No.'));
      }
  }
 
  if ($field_feedback_query_description != '') {
      if (!preg_match("/^[a-zA-Z0-9 ]+$/", $field_feedback_query_description)) {
          $form_state->setErrorByName('body', t('Please enter valid content for Enquiry.'));
      }
  }
  
}
function _custom_key_profiles_validate(array &$form, FormStateInterface $form_state){
    //echo "<pre>"; print_r($form_state); echo "</pre>"; die();
   
    $field_key_profile_contact_detail_value = $form_state->getValue('field_key_profile_contact_detail');
    $field_key_profile_contact_detail = trim($field_key_profile_contact_detail_value['0']['value']);
    if ($field_key_profile_contact_detail != '') {
        if (!preg_match("/^[0-9 ]+$/", $field_key_profile_contact_detail)) {
            $form_state->setErrorByName('field_contact_no', t('Please enter only digit for Contact Details.'));
        }
        $mopbLength = strlen($field_key_profile_contact_detail);
        if($mopbLength > 11 || $mopbLength < 10){
            $form_state->setErrorByName('field_contact_no', t('Please enter maximum 11 and minimum 10 digits for Contact Details.'));
        }
    }
    
}

function _custom_avnl_directory_validate(array &$form, FormStateInterface $form_state){
  //echo "<pre>"; print_r($form_state); echo "</pre>"; die();
 
  $field_avnl_contact_details_value = $form_state->getValue('field_avnl_contact_details');
  $field_avnl_contact_details = trim($field_avnl_contact_details_value['0']['value']);
  
  if ($field_avnl_contact_details != '') {
      if (!preg_match("/^[0-9 ]+$/", $field_avnl_contact_details)) {
          $form_state->setErrorByName('field_contact_no', t('Please enter only digit for Contact Details.'));
      }
      $mopbLength = strlen($field_avnl_contact_details);
      if($mopbLength > 10 || $mopbLength < 10){
          $form_state->setErrorByName('field_avnl_contact_details', t('Please enter maximum 11 and minimum 10 digits for Contact Details.'));
      }
  }
}

function _custom_photo_validate(array &$form, FormStateInterface $form_state){
  $query = \Drupal::request()->query->get('ajax_form');
  $language = \Drupal::languageManager()->getCurrentLanguage()->getId();

  $previousUrl = \Drupal::request()->server->get('HTTP_REFERER'); //exit("--");
  //var_dump($form_state->getRedirect()); echo "</pre>"; exit;
  /* if($previousUrl == ""){
  $form_state->setErrorByName('field_album_cover_image', t('It\'s an illegal triggered action.'));
  } */
  /* if($previousUrl == ""){
    $form_state->setErrorByName('field_photo_gallery_images', t('It\'s an illegal triggered action.'));
