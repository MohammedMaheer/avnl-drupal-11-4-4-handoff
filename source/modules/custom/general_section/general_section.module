function general_section_form_alter(&$form, \Drupal\Core\Form\FormStateInterface $form_state, $form_id){
    // echo $form_id;
    $user = \Drupal::currentUser(); // GET CURRENT USER DATA
    $roles = $user->getRoles(); // GET CURRENT USER ROLE
    $uid = $user->id(); // GET CURRENT USER ID
    $userObj = \Drupal\user\Entity\User::load($uid); 
    //$form['#attributes']['autocomplete'] = "off";										
   if($form_id == "search_block_form"){
      $form['keys']['#prefix']='<div class="searchBoxWrap d-flex flex-wrap">';
      $form['actions']['#suffix'] = '</div>';
      $form['actions']['submit']['#value'] = t('Search');
      $form['actions']['submit']['#attributes']['class'][] = 'ctaBtn ctaFill';
      
      $form['keys']['#attributes']['class'][] = 'form-control';
       //$form['keys']['#attributes']['placeholder'] = t('Enter Keyword..');
       //var_dump($form['keys']['#attributes']);
   }

   if($form_id == "node_awards_achievements_form" || $form_id == "node_awards_achievements_edit_form"){
      if(!in_array('administrator',$roles)){
        $userUnitType = $userObj->field_user_unit_type->target_id;
        $defaultValue = $form['field_awards_achievements_units']['widget']['#default_value'][0];
        if($form_id == "node_awards_achievements_form"){
          foreach($form['field_awards_achievements_units']['widget']['#options'] as $key => $value) {
            if($userUnitType != $key && $key != '_none'){
                unset($form['field_awards_achievements_units']['widget']['#options'][$key]);
            }
          }
        }
        if($form_id == "node_awards_achievements_edit_form"){
            // var_dump($form['field_awards_achievements_units']['widget']['#default_value'][0]);
            if($userUnitType != $defaultValue){
              throw new \Symfony\Component\HttpKernel\Exception\AccessDeniedHttpException();
            } else {
              foreach($form['field_awards_achievements_units']['widget']['#options'] as $key => $value) {
                if($userUnitType != $key && $key != '_none'){
                    unset($form['field_awards_achievements_units']['widget']['#options'][$key]);
                }
              }
            }
        }        
      }
   }

   if($form_id == "node_our_units_form" || $form_id == "node_our_units_edit_form"){
    if(!in_array('administrator',$roles)){
      $userUnitType = $userObj->field_user_unit_type->target_id;
      $defaultValue = $form['field_our_units_category']['widget']['#default_value'][0];
      
      if($form_id == "node_our_units_form"){
        foreach($form['field_our_units_category']['widget']['#options'] as $key => $value) {
          if($userUnitType != $key && $key != '_none'){
              unset($form['field_our_units_category']['widget']['#options'][$key]);
          }
        }
      }
      if($form_id == "node_our_units_edit_form"){
          // var_dump($form['field_our_units_category']['widget']['#default_value'][0]);
          if($userUnitType != $defaultValue){
            throw new \Symfony\Component\HttpKernel\Exception\AccessDeniedHttpException();
          } else {
            foreach($form['field_our_units_category']['widget']['#options'] as $key => $value) {
              if($userUnitType != $key && $key != '_none'){
                  unset($form['field_our_units_category']['widget']['#options'][$key]);
              }
            }
          }
      }        
    }
 }

 if($form_id == "node_tenders_form" || $form_id == "node_tenders_edit_form"){
  if(!in_array('administrator',$roles)){
    $userUnitType = $userObj->field_tender_category->target_id;
    $defaultValue = $form['field_tenders_category']['widget']['#default_value'][0];
    
    if($form_id == "node_tenders_form"){
      foreach($form['field_tenders_category']['widget']['#options'] as $key => $value) {
        if($userUnitType != $key && $key != '_none'){
            unset($form['field_tenders_category']['widget']['#options'][$key]);
        }
      }
