function _feedback_custom_redirect(array &$form, FormStateInterface $form_state){
  global $base_url; 
  //drupal_set_message(t("Your feedback has been submitted successfully."),'status');
  $language = \Drupal::languageManager()->getCurrentLanguage()->getId();
  $default_languagecode = \Drupal::languageManager()->getDefaultLanguage()->getId();
    if ($language != $default_languagecode) {
    $base_urls = $base_url.'/'.$language;
  }else{
    $base_urls = $base_url;
  }
  
  $message =  \Drupal::messenger()->addStatus(t("Your feedback has been submitted successfully."),false);
  $url = $base_urls.'/thank-you';
  $response = new Symfony\Component\HttpFoundation\RedirectResponse($url);
  $response->send(); // don't send the response yourself inside controller and form.
}

function _online_enquiry_custom_redirect(array &$form, FormStateInterface $form_state){
  global $base_url; 
  //drupal_set_message(t("Your feedback has been submitted successfully."),'status');
  $language = \Drupal::languageManager()->getCurrentLanguage()->getId();
  $default_languagecode = \Drupal::languageManager()->getDefaultLanguage()->getId();
    if ($language != $default_languagecode) {
    $base_urls = $base_url.'/'.$language;
  }else{
    $base_urls = $base_url;
  }
  
  $message =  \Drupal::messenger()->addStatus(t("Your Online enquiry has been submitted successfully."),false);
  $url = $base_urls.'/thank-you';
  $response = new Symfony\Component\HttpFoundation\RedirectResponse($url);
  $response->send(); // don't send the response yourself inside controller and form.
}







function general_section_mail($key, &$message, $params) {
  $options = array(
    'langcode' => $message['langcode'],
  );
  switch ($key) {
    case 'send_to_user':
        $message['from'] = \Drupal::config('system.site')->get('mail');
        if($params['msg_type'] == "feedback_query"){
          $message['subject'] = t('Thank you for submitting form');
        }else if($params['msg_type'] == "submit_query"){
          $message['subject'] = t('Thank you for submitting form');
        }
        else{
            $message['subject'] = t('Thank you for submitting form: @title', array('@title' => $params['node_title']), $options);
          } 
      //$message['from'] = \Drupal::config('system.site')->get('mail');
     // $message['subject'] = t('Thank you for submitting form: @title', array('@title' => $params['node_title']), $options);
      $message['body'][] = Html::normalize($params['message']);
      break;
    case 'send_to_admin':
        $message['from'] = \Drupal::config('system.site')->get('mail');
      if($params['msg_type'] == "feedback_query"){
        $message['subject'] = t('Thank you for submitting form');
        }else if($params['msg_type'] == "submit_query"){
            $message['subject'] = t('Thank you for submitting form');
        }else{
        $message['subject'] = t('New form request has been submit by : @title', array('@title' => $params['node_title']), $options);
      }
      //$message['from'] = \Drupal::config('system.site')->get('mail');
      //$message['subject'] = t('New form request has been submit by : @title', array('@title' => $params['node_title']), $options);
      $message['body'][] = Html::normalize($params['message']);
      break;
  }
}







/**
 * Implements hook_mail_alter().
 */
function general_section_mail_alter(&$message) {
  switch ($message['key']) {
    case 'send_to_user':
      $message['headers']['Content-Type'] = 'text/html; charset=UTF-8; format=flowed';
      break;
    case 'send_to_admin':
      $message['headers']['Content-Type'] = 'text/html; charset=UTF-8; format=flowed';
      break;
  }
}
/**
 * Implements for send mail to user custom code
 */
function _druapl_send_custom_mail($module, $key, $to, $langcode, $params = array(), $reply = NULL, $send = TRUE){
    
    $message = "";
    
    $mailManager =  \Drupal::service('plugin.manager.mail');
    $result = $mailManager->mail($module, $key, $to, $langcode, $params, $reply, $send);
    //echo "<pre>"; print_r($result); exit;
    if ($result['result'] == "") {
      $error = true;
    }
    
    if(isset($error)){
        $message_error = t('There was a problem sending email to @email .', array('@email' => $to));
        \Drupal::messenger()->addError($message_error);
        $message = $message_error;
    }else{
    if($key != 'send_to_admin'){
      $message_success = t('An email notification has been successfully sent to @email.', array('@email' => $to));
      \Drupal::messenger()->addStatus($message_success);
      $message = $message_success;
    }
    }
    return $message;
}
/**
 * Implements hook_node_presave().
 */
function general_section_views_query_alter(ViewExecutable $view, QueryPluginBase $query){
  global $base_url;

  $user = \Drupal::currentUser(); // GET CURRENT USER DATA
  $roles = $user->getRoles(); // GET CURRENT USER ROLE
  $uid = $user->id(); // GET CURRENT USER ID
  $userObj = \Drupal\user\Entity\User::load($uid); 

  $language = \Drupal::languageManager()->getCurrentLanguage()->getId();
  // echo "=>".$view->id();
  // echo "=>".$view->current_display; 

  if($view->id() == "inner_banner" && $view->current_display == "block_1")
  {
    $current_path = \Drupal::service('path.current')->getPath();
    //var_dump($current_path);
    //$system_uri = 'entity:' . trim($current_path, '/');
    $system_uri = trim($current_path, '/');
     //var_dump($system_uri);
    $queryMenu = \Drupal::entityQuery('menu_link_content')
    ->condition('menu_name','administrator-menu','!=')
    ->condition('link.uri', '%'.$system_uri.'%', 'LIKE');
   // $result = $queryMenu->execute();
    $result = $queryMenu->accessCheck(FALSE)->execute();
    // var_dump($result); 
    $menu_link_id = (!empty($result)) ? reset($result) : '';
   // var_dump($menu_link_id);
    //exit;
    //echo "<pre>"; print_r($query->where); echo "</pre>"; //exit('--');
     if($menu_link_id){
       //$query->where['1']['conditions'][3]['value'] = $menu_link_id;
       $query->where['1']['conditions'][2]['value'] = $menu_link_id;
     }
    
    //var_dump($query->where['1']['conditions'][2]);
    
  }

  if($view->id() == "moderated_content" && $view->current_display == "moderated_content"){
    if(!in_array('administrator',$roles)){      
      // if($_GET['type'] == 'awards_achievements'){
        $userUnitType = $userObj->field_user_unit_type->target_id;
        if(in_array('awards_achievements_publisher',$roles) || in_array('our_units_publisher',$roles) || in_array('tender_admin', $roles)){
            // echo "<pre>"; var_dump($query->where[0]['conditions']['0']['value'][':node__field_awards_achievements_units_field_awards_achievements_units_target_id']); echo "</pre>"; //exit('--');
            $query->where[0]['conditions']['0']['value'][':node__field_awards_achievements_units_field_awards_achievements_units_target_id'] = $userUnitType;
            // echo "<pre>"; var_dump($query->where[0]['conditions']['0']['value'][':node__field_awards_achievements_units_field_awards_achievements_units_target_id']); echo "</pre>"; //exit('--');
        } else {
            unset($query->where[0]['conditions']['0']);
        }
      // } else {
      //     unset($query->where[0]['conditions']['0']);
      // }
    } else {
        unset($query->where[0]['conditions']['0']);
    }
  }

}

