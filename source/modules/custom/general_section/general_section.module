   if($form_id == "user_login_form"){
        global $base_url;
        $form['#prefix'] ='<div class="loginForm">';
        $form['name']['#attributes']['class'][] = 'form-control';
        //echo "<pre />"; var_dump($form['name']); exit;
        unset($form['name']['description']);
        $form['pass']['#attributes']['class'][] = 'form-control';
        unset($form['pass']['description']);
        $form['actions']['suffix'] = array(
            '#prefix' => '<div class="backendLoginWrap"><a class="buttonLink" href="'.$base_url.'/user/password">Forgot Password?</a></div>',
            '#suffix' => '',
        );
        $form['captcha']['#prefix']="<div class='btnCaptchaRow cf'>";
        $form['actions']['#suffix']="</div>";
        $form['#suffix'] ='</div>';
    }

    if($form_id == "user_pass"){
      global $base_url;
      $form['#prefix'] ='<div class="loginForm">';
      $form['name']['#attributes']['class'][] = 'form-control';
      $form['pass']['#attributes']['class'][] = 'form-control';
      $form['captcha']['#prefix']="<div class='btnCaptchaRow cf'>";
      $form['actions']['#suffix']="</div>";
      $form['#suffix'] ='</div>';
  }
  
   if($form_id == "search_block_form"){
    $form['actions']['#id'] = 'custom-search-actions'; // Set a unique ID for the actions wrapper
     $form['#prefix']="<div class='searchListing'>";
     $form['#suffix']="</div>";
   }
 
   
  if($form_id == "search_form"){
    $form['#prefix']="<div class='searchListing searchDetalispage'>";
