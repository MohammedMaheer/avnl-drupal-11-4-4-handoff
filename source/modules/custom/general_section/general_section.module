  if ($form_id == "node_feedback_form") {
    $user = \Drupal::currentUser(); // GET CURRENT USER DATA
    $uid = $user->id(); // GET CURRENT USER ID
    $roles = $user->getRoles(); // GET CURRENT USER ROLE

    if (in_array('administrator', $roles)) {
        throw new \Symfony\Component\HttpKernel\Exception\AccessDeniedHttpException();
    }

    $form['#attributes']['novalidate'] = 'novalidate';
    $form['#attributes']['autocomplete'] = 'off';
    $form['#title'] = t('Feedback');
   // $form['#prefix'] = "<div class='loginForm feedback-form'>";
  $form['#prefix'] = '<div class="loginForm feedback-form"><div class="mandatoryfeedback"><span>* ' . t('All fields are Mandatory') . '</span></div>';
    $form['#suffix'] = "</div>";

    if (isset($form['advanced'])) {
      unset($form['advanced']); // Removes the entire vertical tabs
    }
    // Remove vertical_tabs element and its label
    if (isset($form['vertical_tabs']['#type']) && $form['vertical_tabs']['#type'] === 'vertical_tabs') {
      // Remove the visually-hidden class and unset the 'for' attribute
      $form['vertical_tabs']['#attributes']['class'] = array_diff(
          $form['vertical_tabs']['#attributes']['class'] ?? [],
          ['form-item__label', 'visually-hidden']
      );
  
      // Unset the 'for' attribute if it exists
      if (isset($form['vertical_tabs']['#attributes']['for']) && $form['vertical_tabs']['#attributes']['for'] === 'edit-advanced') { 
          unset($form['vertical_tabs']['#attributes']['for']);
      }
  }
  

    $form['#validate'][] = '_custom_feedback_validate';
    $form['actions']['#id'] = 'custom-feedback-actions'; // Set a unique ID for the actions wrapper
    $form['actions']['submit']['#value'] = t('Submit');
    $form['actions']['submit']['#id'] = 'custom-feedback-submit'; // Set a unique ID for the submit button
    $form['actions']['submit']['#submit'][] = '_feedback_custom_redirect';

    $form['captcha']['#prefix'] = "<div class='btnCaptchaRow cf'>";
  //  $form['actions']['#suffix'] = "</div><div class='mandatoryfeedback'><span>*" . t('All fields are Mandatory') . "</span></div>";
  $form['actions']['#suffix'] = "</div>";

    if (isset($form['form_build_id']['#type']) && $form['form_build_id']['#type'] == 'hidden') {
        // WCAG forbids hidden input elements with an autocomplete on/off.
        unset($form['form_build_id']['#attributes']['autocomplete']);
    }
}

