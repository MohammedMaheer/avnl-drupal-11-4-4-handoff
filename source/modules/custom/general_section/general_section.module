function __mail_format_change($emailid){
    $email_at = str_replace("@", "[at]", $emailid);
    $email = str_replace(".", "[dot]",$email_at);
    return $email;
} 

function general_section_preprocess_form_element_label(&$variables) {
  // Ensure input_id is set.
  if (!isset($variables['input_id'])) {
    $variables['input_id'] =  $variables['element']['#id'];
  }
