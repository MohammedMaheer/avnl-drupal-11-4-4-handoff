}
function archive_option_views_pre_view(ViewExecutable $view) {

  $config = \Drupal::config('archive_option.adminsettings'); 
  if (!empty($config->get('archive_option'))){
    // Map node type to filter field
    $type_to_filter = [
      'news' => 'field_single_date_value',
      'career_vacancy' => 'field_single_date_time_value',
      'downloads' => 'field_date_value',
      'events' => 'field_date_range_end_value',
      'message_board' => 'field_single_date_value',
      'procurement_manuals' => 'field_archive_date_value',
      'press_release' => 'field_single_date_value',
    ];
    $route_match = \Drupal::service('current_route_match');
    $current_view_id = $view->id();
    foreach ($config->get('archive_option') as $key => $type) {
      if ($type != "" && isset($type_to_filter[$type])) {
        // Only apply if this is the correct view
        if ($current_view_id == $type || $route_match->getParameter('view_id') == $type) {
          $archivalDays = $config->get($type.'_archive_days');
          $filters = $view->display_handler->getOption('filters');
          $filter_field = $type_to_filter[$type];
          if (isset($filters[$filter_field]['value'])) {
            $filters[$filter_field]['value']['value'] = '-'.$archivalDays.' day';
            $view->display_handler->overrideOption('filters', $filters);
          }
        }
      }
    }
  }
  
}

?>