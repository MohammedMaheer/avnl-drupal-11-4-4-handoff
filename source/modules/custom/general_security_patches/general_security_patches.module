function _custom_XSS_views_validate(array &$form, FormStateInterface $form_state){
  global $base_url;
  $values = $form_state->getUserInput();
  $current_path = \Drupal::service('path.current')->getPath();
  $pageUrl = \Drupal::service('path_alias.manager')->getAliasByPath($current_path);
  $url = $base_url.$pageUrl; 
//$url = $base_url.$pageUrl.'?test=test123'; 
  //$error = array();
  //var_dump($values['title']); //exit;
  if((isset($values['title']) && $values['title'] != "") || (isset($values['combine']) && $values['combine'] != "")){
      // $setArrayForXss = array("+","-","_","!","@","#","$","%","^","*","=","{","}","\\","/","'",",",":",";","`","~","<",">");
      $setArrayForXss = array("+","_","@","#","$","%","^","*","=","{","}","\\","/","'",",",":",";","`","~","<",">");
      //$title = str_replace($setArrayForXss,' ',$values['title']);
      //echo "==>".($title)."<==";
      if(!isset($values['title']) || $values['title'] == ""){
          $getDataTitle = isset($values['combine']) ? $values['combine'] : '';
      }else{
          $getDataTitle = $values['title'];
      }
      $error = array();
      foreach($setArrayForXss as $keyword){
          //var_dump($keyword);
          if (strpos($getDataTitle, $keyword) !== FALSE) {
              //var_dump($keyword);
              //echo "11"; //exit;
              $error[] = true;
              
          }
      }
                 
  }
  if(!empty($error)){
      // drupal_set_message(t('Please enter valid details for Searching Field.'), 'error');
      $form_state->setErrorByName('title', t('Please enter valid details for Searching Field.'));
      return $form;
  }
}

