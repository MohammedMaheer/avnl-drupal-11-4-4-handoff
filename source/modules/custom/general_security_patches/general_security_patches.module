function _custom_rate_limit_validate(array &$form, FormStateInterface $form_state) {
  $ipaddress = _gsp_get_client_ip(); // Get client IP
  $form_id = $form['#id']; // Get form ID
  $database = \Drupal::database();

  $limit_access = 5; // Max allowed attempts
  $expiry_window = 1800; // 1 hour (in seconds)

  // Get the latest rate limit record
  $queryRl = $database->select('rate_limit', "rl")
    ->condition('rl.form_id', $form_id)
    ->condition('rl.ip_address', $ipaddress)
    ->fields('rl', ['form_id', 'ip_address', 'created', 'access_count'])
    ->orderBy('rl.created', 'DESC')
    ->range(0, 1);
  $resultsRl = $queryRl->execute();
  $rlresult = $resultsRl->fetchAll();

  $current_time = \Drupal::time()->getRequestTime();

  if (!empty($rlresult)) {
    $record = $rlresult[0];
    $rcount = $record->access_count;
    $created_time = $record->created;

    // If time since last record exceeds expiry, reset count
    if (($current_time - $created_time) > $expiry_window) {
      $ratecount = 1;
      $database->update('rate_limit')
        ->fields([
          'access_count' => $ratecount,
          'created' => $current_time,
          'updated' => $current_time,
        ])
        ->condition('form_id', $form_id)
        ->condition('ip_address', $ipaddress)
        ->execute();
    }
    elseif ($rcount < $limit_access) {
      $ratecount = $rcount + 1;
      $database->update('rate_limit')
        ->fields([
          'access_count' => $ratecount,
          'updated' => $current_time,
        ])
        ->condition('form_id', $form_id)
        ->condition('ip_address', $ipaddress)
        ->execute();
    }
    else {
      \Drupal::service('session_manager')->destroy();
      \Drupal::messenger()->addMessage(t('We have received multiple requests from your IP address. Please try again after some time.'), 'error');
      $form_state->setErrorByName('name', t('Please wait and try again later.'));
    }
  }
  else {
    // No existing record, insert new
    $database->insert('rate_limit')
      ->fields([
        'form_id' => $form_id,
        'ip_address' => $ipaddress,
        'access_count' => 1,
        'created' => $current_time,
      ])
      ->execute();
  }
}


function _custom_password_validate(array &$form, FormStateInterface $form_state){
    $user = \Drupal::currentUser(); // GET CURRENT USER DATA
    $roles = $user->getRoles(); // GET CURRENT USER ROLE	
    $uid = $user->id();											 
    //$query = \Drupal::request()->query->get('ajax_form');
    //if($query == ""){
        $values = $form_state->getUserInput();
        $username = isset($values['name']) ? $values['name'] : '';
        $new_password = $values['pass']['pass1'] ?? '';
        $field_official_contact_number = '';
        if (isset($values['field_official_contact_number']) && is_array($values['field_official_contact_number']) && 
            isset($values['field_official_contact_number'][0]) && is_array($values['field_official_contact_number'][0]) &&
            isset($values['field_official_contact_number'][0]['value'])) {
            $field_official_contact_number = $values['field_official_contact_number'][0]['value'];
        }
        if ($new_password !== '' && $username === $new_password)
        {
          $form_state->setErrorByName('error', t('Please enter username and password does not same.'));
        }
    
        if($username != ""){
            if(strlen($username) < 3){
                $form_state->setErrorByName('name', t('Please enter at least 3 character content for Username.'));
            }
        }
        if ($new_password !== '') {
            if(isset($values['pass']['pass2']) && $new_password === $values['pass']['pass2'] ){
                if (!preg_match("/^.*(?=.{8,})(?=.*[0-9])(?=.*[a-z])(?=.*[A-Z]).*$/", $new_password)) {
                    $form_state->setErrorByName('pass', t('Password must be at least 8 characters and must contain at least one lower case letter, one upper case letter and one digit.'));
                }
            }

            if ($uid && \Drupal::database()->schema()->tableExists('login_attampt')) {
                $hashes = \Drupal::database()->select('login_attampt', 'la')
                    ->fields('la', ['pass'])
                    ->condition('uid', $uid)
                    ->orderBy('created', 'DESC')
                    ->range(0, 5)
                    ->execute()
                    ->fetchCol();
                $password_hasher = \Drupal::service('password');
                foreach ($hashes as $hash) {
                    if ($password_hasher->check($new_password, $hash)) {
                        $form_state->setErrorByName('pass', t('This password was used recently. Please choose a different password.'));
                        break;
                    }
                }
            }
        }
        if($field_official_contact_number != ""){
            $mobileObject = \Drupal::entityTypeManager()->getStorage('user')->loadByProperties(['field_official_contact_number' => $field_official_contact_number]);
            if(!in_array('administrator',$roles)){
              //var_dump(key($mobileObject));
              if($uid != key($mobileObject)){
                if(!empty($mobileObject)){
                    $form_state->setErrorByName('field_official_contact_number', t('Mobile Number is already exist..'));
                }
              }
            }
        }
        
        
        
    //}

    
}

/**
 * Stores a one-way password-history hash after a user form is submitted.
 */
function general_security_patches_password_history_submit(array &$form, FormStateInterface $form_state) {
    $new_password = $form_state->getValue(['pass', 'pass1']);
    if (!is_string($new_password) || $new_password === '') {
        return;
    }

    $form_object = $form_state->getFormObject();
    if (!method_exists($form_object, 'getEntity')) {
        return;
    }
    $account = $form_object->getEntity();
    if (!$account || !$account->id() || !\Drupal::database()->schema()->tableExists('login_attampt')) {
        return;
    }

    $hash = \Drupal::service('password')->hash($new_password);
    if ($hash === FALSE) {
        return;
    }
    \Drupal::database()->insert('login_attampt')
        ->fields([
            'uid' => $account->id(),
            'pass' => $hash,
            'created' => \Drupal::time()->getRequestTime(),
        ])
        ->execute();
}

