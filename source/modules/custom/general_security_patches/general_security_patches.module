/**
 * Implements hook_mail().
 */
function general_security_patches_mail($key, &$message, $params) {
  $options = array(
    'langcode' => $message['langcode'],
  );
  //echo $key .'-'.var_dump($message) .'-'. var_dump($params); exit('---');
  switch ($key) {
    case 'send_to_user':
      $message['from'] = \Drupal::config('system.site')->get('mail');
      //$message['subject'] = t('Thank you for submitting form: @title', array('@title' => $params['node_title']), $options);
      $message['subject'] = t('Thank you for submitting form');
      $message['body'][] = Html::normalize($params['message']);
      break;
    case 'send_to_admin':
      $message['from'] = \Drupal::config('system.site')->get('mail');
      $message['subject'] = t('New feedback form request has been submitted by : @title', array('@title' => $params['node_title']), $options);
      $message['body'][] = Html::normalize($params['message']);
      break;
  }
}
/**
 * Implements hook_mail_alter().
 */
function general_security_patches_mail_alter(&$message) {
  switch ($message['key']) {
    case 'send_to_user':
      $message['headers']['Content-Type'] = 'text/html; charset=UTF-8; format=flowed';
      break;
    case 'send_to_admin':
      $message['headers']['Content-Type'] = 'text/html; charset=UTF-8; format=flowed';
      break;
  }
}
/**
 * Implements for send mail to user custom code
 */
function __gsp_druapl_send_custom_mail($module, $key, $to, $langcode, $params = array(), $reply = NULL, $send = TRUE){
    
    $message = "";
    
    $mailManager =  \Drupal::service('plugin.manager.mail');
    $result = $mailManager->mail($module, $key, $to, $langcode, $params, $reply, $send);
    //echo "<pre>"; print_r($result); exit;
    if ($result['result'] == "") {
      $error = true;
    }
    
    if(isset($error)){
        $message_error = t('There was a problem sending email to @email .', array('@email' => $to));
        \Drupal::messenger()->addError($message_error);
        $message = $message_error;
    }else{
    if($key != 'send_to_admin'){
      $message_success = t('An email notification has been successfully sent to @email.', array('@email' => $to));
      \Drupal::messenger()->addStatus($message_success);
      $message = $message_success;
    }
    }
    return $message;
}

