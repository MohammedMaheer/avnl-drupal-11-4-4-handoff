function general_security_patches_file_validate(Drupal\file\FileInterface $file) {
  //echo "----TEST----";
  //exit($file->getFilename());
  //$errors[] = t($file->source);
  //$errors[] = t($file->getFileUri());
  //$errors[] = t($file->getFilename());
  //$errors[] = t($file->getMimeType());
  // Call the validation functions specified by this function's caller.
  $errors = array();
  $query = \Drupal::request()->query->get('ajax_form');
    if($query != ""){  
        if (!$file->getFilename()) {
          $errors[] = t("The file's name is empty. Please give a name to the file.");
        }
        if (strlen($file->getFilename()) > 255) {
          $errors[] = t("The file's name exceeds the 255 characters limit. Please rename the file and try again.");
        }
    if($file->getFilename() != ""){
      if(!preg_match("/^[a-zA-Z-0-9_-]+[.]{1}[a-zA-z0-9]{3,4}$/", $file->getFilename())){
        $errors[] = t("The file name should not contains any Null Byte extensions or double dots (.)");
      }
      $removeChars = array('\0', '%00', '0x00');
      $processed_filename = str_replace($removeChars, '', $file->getFilename());
      if (strlen($file->getFilename()) != strlen($processed_filename)) {
        $errors[] = t("Upload File with Proper file name.");
      }

      if($file->getFileUri()){
        $fileData = file_get_contents($file->getFileUri());        
        if($fileData != ""){          
          $ext = pathinfo($file->getFilename(), PATHINFO_EXTENSION);
          $extValid = array('png','gif','jpg','jpeg');
          if(in_array($ext, $extValid)){     
            if($ext == 'jpg' || $ext == 'jpeg'){
              $image = imagecreatefromjpeg($file->getFileUri());
            } else if ($ext == 'png'){
              $image = imagecreatefrompng($file->getFileUri());
            } else if ($ext == 'gif'){
              $image = imagecreatefromgif($file->getFileUri());
            }
            if ($image == false) { 
              $errors[] = t("Please upload valid file....");
            }
          }
          
        }
      }

    }

        if($file->getFileUri() != ''){
          $tempUrl = $file->getFileUri();
          //Check the Real MIME TYPE of Uploaded file.

          $finfo = finfo_open(FILEINFO_MIME);
          //$errors[] = $finfo;
          $uploaded_file_mimetype = finfo_file($finfo, $tempUrl); 
          //$errors[] = $uploaded_file_mimetype;

          //Compare the Extension with Allowed Extension. 
          if($uploaded_file_mimetype != false){
              //Get the Proper MIME TYPE
              if(strpos($uploaded_file_mimetype, ';') != false){
                  $mime_type = strtolower(substr($uploaded_file_mimetype, 0, strpos($uploaded_file_mimetype, ';')));
              } else {    
                  $mime_type = strtolower($uploaded_file_mimetype);
              }
      
              //$errors[] = $file->getMimeType();
              //$errors[] = $mime_type;
              if($file->getMimeType() != $mime_type){
                  $errors[] = t("Please upload valid file.");
              }

          } else {
              $errors[] = t("Please Upload the file before Save the content.");
          }
        }

        return $errors;
    }
}

function _gsp_get_client_ip() {
    //echo "<pre>"; print_r($_SERVER); echo "</pre>"; exit;
    $ipaddress = '';
    if (getenv('HTTP_CLIENT_IP'))
        $ipaddress = getenv('HTTP_CLIENT_IP');
    else if (getenv('HTTP_X_FORWARDED_FOR'))
        $ipaddress = getenv('HTTP_X_FORWARDED_FOR');
    else if (getenv('HTTP_X_FORWARDED'))
        $ipaddress = getenv('HTTP_X_FORWARDED');
    else if (getenv('HTTP_FORWARDED_FOR'))
        $ipaddress = getenv('HTTP_FORWARDED_FOR');
    else if (getenv('HTTP_FORWARDED'))
        $ipaddress = getenv('HTTP_FORWARDED');
    else if (getenv('REMOTE_ADDR'))
        $ipaddress = getenv('REMOTE_ADDR');
    else
        $ipaddress = 'UNKNOWN';
    return $ipaddress;
}

function _gsp_mail_format_change($emailid){
    $email_at = str_replace("@", "[at]", $emailid);
    $email = str_replace(".", "[dot]",$email_at);
    return $email;
}        



