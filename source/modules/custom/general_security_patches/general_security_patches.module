function general_security_patches_form_alter(&$form, \Drupal\Core\Form\FormStateInterface $form_state, $form_id){
  global $base_url;
  $language = \Drupal::languageManager()->getCurrentLanguage()->getId();
    $default_languagecode = \Drupal::languageManager()->getDefaultLanguage()->getId();
    if ($language != $default_languagecode) {
        $base_urls = $base_url.'/'.$language;
    }else{
        $base_urls = $base_url;
    }    
    $user = \Drupal::currentUser(); // GET CURRENT USER DATA
    $roles = $user->getRoles(); // GET CURRENT USER ROLE
    
    if($form_id == "search_block_form"){
    //  $form['#attributes']['autocomplete'] = 'off';
      //$form['keys']['#attributes']['autocomplete'] = 'off';
  }
  if ($form_id === 'user_register_form') {
    $form['actions']['submit']['#value'] = t('Submit');
    $form['#validate'][] = '_custom_password_validate';
    $form['#submit'][] = 'general_security_patches_password_history_submit';
  }

  if ($form_id === 'user_form') {
    $form['#validate'][] = '_custom_password_validate';
    $form['#submit'][] = 'general_security_patches_password_history_submit';
  }

  if ($form_id === 'user_login_form') {
    $form['name']['#attributes']['autocomplete'] = 'username';
    $form['pass']['#attributes']['autocomplete'] = 'current-password';
  }

  if ($form_id === 'user_pass') {
    $form['name']['#attributes']['placeholder'] = t('Username or email address*');
    $form['name']['#description'] = t('Password reset instructions will be sent to your registered email address.');
    $form['name']['#attributes']['autocomplete'] = 'username';
  }

  if ($form_id === 'node_feedback_form' || $form_id === 'node_online_enquiry_form') {
    $form['#validate'][] = '_custom_rate_limit_validate';
  }

  if ($form_id === 'contact_message_feedback_form') {
    $form['actions']['submit']['#value'] = t('Submit');
  }
  
    if(strpos($form_id, 'ode_')){
      $form['#attributes']['autocomplete'] = 'off';
      $form['#validate'][] = '_custom_title_validate';
      $form['actions']['submit']['#value'] = t('Submit');
    }
    
    if($form_id == "views_exposed_form"){
        //echo "==>".$form_id;
    }
    
}
/**
 * @param array $form
 * @param array $form_state
 * @return array
 * Ajax callback for validating the username
 */
function username_validation_ajax(&$form, &$form_state) {
  
  $username = $form_state->getvalues()['name'];
  $label = $form['account']['name']['#title'];
  $max_char = '10';
  $min_char = '3';
  
  $ajax_response = new AjaxResponse();
  $ajax_response->addCommand(new HtmlCommand('#username-validation-ajax', ''));
  if($username == "" || empty($username)){
  $value = '<span class ="error ">' . $label . ' field is required</span>';
    $ajax_response->addCommand(new HtmlCommand('#username-validation-ajax', $value));
  }
  if (strlen($username) < $min_char) {
    $value = '<span class ="error ">' . $label . ' should have minimum of ' . $min_char . ' characters</span>';
    $ajax_response->addCommand(new HtmlCommand('#username-validation-ajax', $value));
  }

  if (strlen($username) > $max_char) {
    $value = '<span class ="error ">' . $label . ' should have maximum of ' . $max_char . ' characters</span>';
    $ajax_response->addCommand(new HtmlCommand('#username-validation-ajax', $value));
  }

  if (preg_match('/\s/',$username)) {
    $value = '<span class ="error ">' . $label . ' contains spaces.</span>';
    $ajax_response->addCommand(new HtmlCommand('#username-validation-ajax', $value));
  }
  
  if (!preg_match('/^[a-zA-Z0-9-_@#$. ]+$/i',$username)) {
    $value = '<span class ="error ">Please enter valid ' . $label . '.</span>';
    $ajax_response->addCommand(new HtmlCommand('#username-validation-ajax', $value));
  }
  
  if($username != ""){
  $account = \Drupal::entityTypeManager()->getStorage('user')->loadByProperties(['name' => $username]);
  if(!empty($account)){
    $value = '<span class ="error ">' . $label . ' is already exists.</span>';
    $ajax_response->addCommand(new HtmlCommand('#username-validation-ajax', $value));
  }
  }
  

  return $ajax_response;
}
