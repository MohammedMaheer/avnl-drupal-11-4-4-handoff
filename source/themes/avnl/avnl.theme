    unset($variables['breadcrumb'][1]);
    unset($variables['breadcrumb'][2]);
    $variables['breadcrumb'][] = ['text' => ('Forum'), 'url' => $base_urls.'/forum'];
  }
  if (!empty($page_title)) {
    //$title = _custom_title_limit_words($page_title,'8') ;
    // var_dump($page_title); exit('-----------------------------');
    $title = $page_title;
    if (is_array($title)) {
  // Title resolver can return an array for some routes.
  $title = reset($title);
}

if ($title instanceof \Drupal\Component\Render\MarkupInterface) {
  $title = (string) $title;
}

$title = (string) $title;
    /* if(isset($title)){
      if(strpos($title, '...') !== false){
         //$titles = _custom_title_limit_words($page_title,'8') ;
         $titles = $page_title;
         $title = str_replace("Create","",$titles);
      }else{
         $title = str_replace("Create","",$page_title);
      }
    } */
  
    $title = str_replace("&amp;","&",$title);	
    //$transTitle = t($title);

    if($rdata[1] == "schemes" && is_numeric($rdata[2])){
      //echo '--'.$rdata[2];
      $term_name = \Drupal\taxonomy\Entity\Term::load($rdata[2])->get('name')->value;
      $variables['breadcrumb'][] = ['text' => $term_name];
    }else{
      $variables['breadcrumb'][] = ['text' => $title]; 
    }
  
  }


  
  }
}
