/**
 * Implements hook_preprocess_HOOK() for HTML document templates.
 *
 * Adds body classes if certain regions have content.
 */
function avnl_preprocess_html(&$variables) {
    // get nonce placeholderKey 
  if (\Drupal::moduleHandler()->moduleExists('csp')) {
    // Build a nonce placeholder (cache-safe)
    $nonce_builder = \Drupal::service('csp.nonce_builder');
    $placeholder_key = $nonce_builder->getPlaceholderKey();
    // Make the placeholder available to Twig (for html.html.twig scripts)
    $variables['csp_nonce_placeholder'] = $placeholder_key;
    // Register lazy builder so Drupal replaces placeholder with actual nonce on render.
    $variables['#attached']['placeholders'][$placeholder_key] = [
      '#lazy_builder' => ['csp.nonce_builder:renderNonce', []],
    ];
    // Tell CSP that we expect to apply nonce to script and style tags.
    $variables['#attached']['csp_nonce'] = [
      'script' => [Csp::POLICY_UNSAFE_INLINE],
      'style' => [Csp::POLICY_UNSAFE_INLINE],
    ];
  }

  $theme_settings = \Drupal::service(ThemeSettingsProvider::class);
  if ($theme_settings->getSetting('mobile_menu_all_widths') === 1) {
    $variables['attributes']['class'][] = 'is-always-mobile-nav';
  }

  //CUSTOM CODE START
  global $base_url;
  
  $language = \Drupal::languageManager()->getCurrentLanguage()->getId();
  $default_languagecode = \Drupal::languageManager()->getDefaultLanguage()->getId();
  if ($language != $default_languagecode) {
      $base_urls = $base_url.'/'.$language;
  }else{
      $base_urls = $base_url;
  }
  $variables['language'] = \Drupal::languageManager()->getCurrentLanguage()->getId();
  if ($node = \Drupal::request()->attributes->get('node')) {
    $routeName = \Drupal::request()->attributes->get('_route');
    if($node!=""){  
        if($routeName != "entity.node.revision"){
            if($node->id()!=""){ $npid = $node->id(); } else { $npid = ""; }
            $variables['attributes']['class'][] = 'page-node-' .$npid ;
            $variables['node_id'] = $node->id() ? $node->id() : $node;
        }
    }
  }
  if($nodeType = \Drupal::request()->attributes->get('node_type')){
    $ntype =  $nodeType->get('type');
    $variables['attributes']['class'][] = 'page-node-type-' . $ntype;  
  }
  $variables['base_url'] = $base_url.'/';
  $variables['base_urls'] = $base_urls.'/';
  //$data = \Drupal::request()->attributes;
//  //var_dump($data);
  if($view_id = \Drupal::request()->attributes->get('view_id') && $display_id = \Drupal::request()->attributes->get('display_id')){
      $view_id = \Drupal::request()->attributes->get('view_id');
      $variables['type_view'] = 'yes';
      $variables['attributes']['class'][] = 'page-views';
      $variables['attributes']['class'][] = 'page-views-'.str_replace('_', '-',$view_id).'-'.str_replace('_', '-', $display_id);
  }
  
  
  $route_match = \Drupal::service('current_route_match');
  //var_dump($route_match->getParameters());
  if($route_match->getParameter('view_id') != ""){
    $variables['arg_0'] = $route_match->getParameter('view_id');
    $variables['arg_1'] = $route_match->getParameter('display_id');
    $variables['arg_2'] = $route_match->getParameter('arg_0');
    $variables['arg_3'] = $route_match->getParameter('arg_1');
  }
  //CUSTOM CODE END

  // Convert custom hex to hsl so we can use the hue value
  $brand_color_hex = $theme_settings->getSetting('base_primary_color') ?? '#1b9ae4';
  [$h, $s, $l] = _avnl_hex_to_hsl($brand_color_hex);

  $variables['html_attributes']->setAttribute('style', "--color--primary-hue:$h;--color--primary-saturation:$s%;--color--primary-lightness:$l");

  // So fonts can be preloaded from base theme in the event avnl is used as a subtheme.
  $variables['avnl_path'] = \Drupal::request()->getBasePath() . '/' . \Drupal::service('extension.list.theme')->getPath('avnl');

  $query_string = \Drupal::state()->get('system.css_js_query_string') ?: '0';

  // Create render array with noscript tag to output non-JavaScript
  // stylesheet for primary menu.
  $variables['noscript_styles'] = [
    '#type' => 'html_tag',
    '#noscript' => TRUE,
    '#tag' => 'link',
    '#attributes' => [
      'rel' => 'stylesheet',
      'href' => $variables['avnl_path'] . '/css/components/navigation/nav-primary-no-js.css?' . $query_string,
    ],
  ];
}


/**
 * Maps a MIME type to a stable, general-purpose file icon class.
 */
function _avnl_file_icon_class(string $mime_type): string {
  return match (TRUE) {
    $mime_type === 'application/pdf' => 'pdf',
    str_starts_with($mime_type, 'image/') => 'image',
    str_starts_with($mime_type, 'audio/') => 'audio',
    str_starts_with($mime_type, 'video/') => 'video',
    str_contains($mime_type, 'zip'), str_contains($mime_type, 'compressed') => 'archive',
    str_contains($mime_type, 'word'), str_contains($mime_type, 'document') => 'document',
    str_contains($mime_type, 'sheet'), str_contains($mime_type, 'excel') => 'spreadsheet',
    str_contains($mime_type, 'presentation'), str_contains($mime_type, 'powerpoint') => 'presentation',
    str_starts_with($mime_type, 'text/') => 'text',
    default => 'general',
  };
}

function avnl_preprocess_file_link(&$variables) {
  $file = $variables['file'];
  $options = [];

  /** @var \Drupal\Core\File\FileUrlGeneratorInterface $file_url_generator */
  $file_url_generator = \Drupal::service('file_url_generator');
  $url = $file_url_generator
    ->generate($file
    ->getFileUri());
  $mime_type = $file
    ->getMimeType();
  $options['attributes']['type'] = $mime_type;

  // Use the description as the link text if available.
  if (empty($variables['description'])) {
    $link_text = $file
      ->getFilename();
  }
  else {
    $link_text = $variables['description']. ' (opens as a PDF)';
    $options['attributes']['title'] = $file
      ->getFilename();

  }
  $options['attributes']['target'] = '_blank';
  // Classes to add to the file field for icons.
  $classes = [
    'file',
    // Add a specific class for each and every mime type.
    'file--mime-' . strtr($mime_type, [
      '/' => '-',
      '.' => '-',
    ]),
    // Add a more general class for groups of well known MIME types.
    'file--' . _avnl_file_icon_class($mime_type),
  ];

  // Set file classes to the options array.
  $variables['attributes'] = new Attribute($variables['attributes']);
  $variables['attributes']
    ->addClass($classes);
  $variables['file_size'] = ByteSizeMarkup::create($file->getSize() ?? 0);
  $variables['link'] = Link::fromTextAndUrl($link_text, $url
    ->mergeOptions($options))
    ->toRenderable();
} 

/* SECURITY PATCHES */
/**
 * Implements hook_page_attachments_alter().
 */
function avnl_page_attachments_alter(array &$attachments) {
  // $getHeaders = getallheaders();
  // var_dump($getHeaders);
  foreach ($attachments['#attached']['html_head'] as $key => $attachment) {
    if ($attachment[1] == 'system_meta_generator') {
    unset($attachments['#attached']['html_head'][$key]);
    }
  }
}

function avnl_js_alter(&$javascript, \Drupal\Core\Asset\AttachedAssetsInterface $assets) {
  //$javascript['core/assets/vendor/jquery/jquery.min.js']['data'] = drupal_get_path('module', 'jquery_update') . '/jquery.js';
  foreach($javascript as $key => $value){
      if($javascript[$key]['data'] == $key){
          $javascript[$key]['version'] = -1; 
      }
  }
}

/**
 * Implements hook_preprocess_HOOK() for page title templates.
 */
 
function avnl_preprocess_page(array &$variables) {
  global $base_url;
  // Existing logic.
  $site_config = \Drupal::config('system.site');
  $variables['site_name'] = $site_config->get('name');
  $variables['site_slogan'] = $site_config->get('slogan');
  $language = \Drupal::languageManager()->getCurrentLanguage()->getId();
  $default_languagecode = \Drupal::languageManager()->getDefaultLanguage()->getId();
  if ($language != $default_languagecode) {
    $base_urls = $base_url . '/' . $language;
  }
  else {
    $base_urls = $base_url;
  }
  $variables['base_url'] = $base_url . '/';
  $variables['base_urls'] = $base_urls . '/';
  $current_path = \Drupal::service('path.current')->getPath();
  $system_uri = trim($current_path, '/');
  $archive = explode('/', $system_uri);
  if ($archive[0] == 'archive') {
    $variables['archive_val'] = 1;
  }
  else {
    $variables['archive_val'] = 0;
  }
  if ($node = \Drupal::request()->attributes->get('node')) {
    if ($node->getType()) {
      $title = trim($node->type->entity->label());
      if ($title != "" && $title != "Basic page" && $title != "Article" &&
          ($title != "Feedback" || $title != "प्रतिक्रिया") && $title != "FAQ" &&
          $title != "commissioner Official" && $title != "Monographs") {
        $variables['updated_titles'] = $title;
        $page_title = !empty($variables['title']) ?
          $variables['title'] :
          \Drupal::service('title_resolver')->getTitle(\Drupal::request(), \Drupal::routeMatch()->getRouteObject());
        $variables['paged_title'] = '<h2>' . $page_title . '</h2>';
      }
    }
  }
  // block password autocomplete, copy-paste via external js
  $route = \Drupal::routeMatch()->getRouteName();
  if (in_array($route, ['user.login','user.register','user.pass'], TRUE)) {
    $variables['#attached']['library'][] = 'avnl/disable_password';
  }


}
 
function avnl_preprocess_page_title(&$variables) {
  // Since the title and the shortcut link are both block level elements,
  // positioning them next to each other is much simpler with a wrapper div.
  if (!empty($variables['title_suffix']['add_or_remove_shortcut']) && $variables['title']) {
    // Add a wrapper div using the title_prefix and title_suffix render
    // elements.
    $variables['title_prefix']['shortcut_wrapper'] = [
      '#markup' => '<div class="shortcut-wrapper">',
      '#weight' => 100,
    ];
    $variables['title_suffix']['shortcut_wrapper'] = [
      '#markup' => '</div>',
      '#weight' => -99,
    ];

    // Make sure the shortcut link is the first item in title_suffix.
    $variables['title_suffix']['add_or_remove_shortcut']['#weight'] = -100;
  }

  // Unset shortcut link on front page.
  $variables['is_front'] = \Drupal::service('path.matcher')->isFrontPage();
  if ($variables['is_front'] === TRUE) {
    unset($variables['title_suffix']['add_or_remove_shortcut']);
  }
}

/**
 * Implements hook_preprocess_HOOK() for maintenance-page.html.twig.
 */
function avnl_preprocess_maintenance_page(&$variables) {
  // By default, site_name is set to Drupal if no db connection is available
  // or during site installation. Setting site_name to an empty string makes
  // the site and update pages look cleaner.
  // @see template_preprocess_maintenance_page
  if (!$variables['db_is_active']) {
    $variables['site_name'] = '';
  }

  // avnl has custom styling for the maintenance page.
  $variables['#attached']['library'][] = 'avnl/maintenance-page';
}

/**
 * Implements hook_preprocess_HOOK() for node.html.twig.
 */
function avnl_preprocess_node(&$variables) {
  // Remove the "Add new comment" link on teasers or when the comment form is
  // displayed on the page.
  if ($variables['teaser'] || !empty($variables['content']['comments']['comment_form'])) {
    unset($variables['content']['links']['comment']['#links']['comment-add']);
  }

  // Apply custom date formatter to "date" field.
  if (!empty($variables['date']) && !empty($variables['display_submitted']) && $variables['display_submitted'] === TRUE) {
    $variables['date'] = \Drupal::service('date.formatter')->format($variables['node']->getCreatedTime(), 'avnl_medium');
  }

  // Pass layout variable to template if content type is article in full view
  // mode. This is then used in the template to create a BEM style CSS class to
  // control the layout.
  if ($variables['node']->bundle() === 'article' && $variables['view_mode'] === 'full') {
    $variables['layout'] = 'content-narrow';
  }
}

/**
 * Implements hook_preprocess_HOOK() for block.html.twig.
 */
function avnl_preprocess_block(&$variables) {
  if (!empty($variables['elements']['#id'])) {
    /** @var \Drupal\block\BlockInterface $block */
    $block = \Drupal::entityTypeManager()
      ->getStorage('block')
      ->load($variables['elements']['#id']);
    if ($block) {
      $region = $block->getRegion();

      if ($variables['base_plugin_id'] === 'system_menu_block') {
        $variables['content']['#attributes']['region'] = $region;
        if ($region === 'sidebar') {
          $variables['#attached']['library'][] = 'avnl/menu-sidebar';
        }
      }

      if($variables['elements']['#base_plugin_id'] === 'search_form_block'){
        // var_dump($variables);
         $form = $variables['elements']['content'];
           $renderer = \Drupal::service('renderer');
  $form['#children']['keys']['#attributes']['placeholder'] = t('Search AVNL');
        $variables['input'] = $renderer->renderRoot($form['#children']['keys']);
          $variables['submit'] = $renderer->renderRoot($form['#children']['actions']['submit']);
      }

  
      if ($variables['base_plugin_id'] === 'search_form_block') {

        if ($region === 'primary_menu') {
          $variables['#attached']['library'][] = 'avnl/search-narrow';
          $variables['content']['actions']['submit']['#theme_wrappers'] = ['input__submit__header_search'];
        }
        elseif ($region === 'secondary_menu') {
          $variables['#attached']['library'][] = 'avnl/search-wide';
          $variables['content']['actions']['submit']['#theme_wrappers'] = ['input__submit__header_search'];
        }

         // Unset or modify the 'autocomplete' attribute
         if (isset($variables['content']['#attributes']['autocomplete'])) {
          unset($variables['content']['#attributes']['autocomplete']); // Remove autocomplete="off"
        } else {
          $variables['content']['#attributes']['autocomplete'] = 'on'; // Ensure autocomplete="on"
        }

      }
    }
  }

  if ($variables['plugin_id'] === 'system_branding_block') {
    $site_branding_color = \Drupal::service(ThemeSettingsProvider::class)->getSetting('site_branding_bg_color');
    if ($site_branding_color && $site_branding_color !== 'default') {
      $variables['attributes']['class'][] = 'site-branding--bg-' . $site_branding_color;
    }
  }
  //var_dump($variables['plugin_id']);
  // Add a primary-nav class to main menu navigation block.
  if ($variables['plugin_id'] === 'system_menu_block:main') {
    $variables['attributes']['class'][] = 'primary-nav';
  }

}

function avnl_theme_suggestions_field_alter(array &$suggestions, array $variables) {
  if(!empty($variables['elements']['#id'])){
    $block = $variables['elements']['#id'];
    // Add a theme suggestion for a specific block machine name.
    if ($block == 'homepagelogo') {
      $suggestions[] = 'block__my_block_machine_name';
    }
  }
  
}

/**
 * Implements hook_theme_suggestions_HOOK_alter() for menu.
 */
function avnl_theme_suggestions_menu_alter(&$suggestions, array $variables) {
  if (isset($variables['attributes']['region'])) {
    $suggestions[] = 'menu__' . $variables['attributes']['region'];
  }
}

/**
 * Implements hook_preprocess_HOOK().
 */
function avnl_preprocess_menu(&$variables) {
  //var_dump($variables['attributes']);
  if (isset($variables['attributes']['region'])) {
    if ($variables['attributes']['region'] === 'sidebar') {
      $variables['attributes']['class'][] = 'menu--sidebar';
    }
    unset($variables['attributes']['region']);
  }

  // Check if the menu exists in the variable.
  if (isset($variables['items'])) {
    foreach ($variables['items'] as &$item) {
      // Unset the 'filesize' attribute if it exists.
      if (isset($item['attributes']['filesize'])) {
        unset($item['attributes']['filesize']);
      }

      // You can also unset other attributes similarly.
      // if (isset($item['attributes']['class'])) {
      //   unset($item['attributes']['class']);
      // }
    }
  }
}

/**
 * Implements hook_theme_suggestions_HOOK_alter() for form templates.
 */
function avnl_theme_suggestions_form_alter(array &$suggestions, array $variables) {
  if ($variables['element']['#form_id'] === 'search_block_form') {
    $suggestions[] = 'form__search_block_form';
  }
}

