{#
/**
 * @file
 * Theme override for a link to a file.
 *
 * Available variables:
 * - attributes: The HTML attributes for the containing element.
 * - link: A link to the file.
 * - file_size: The size of the file.
 *
 * @see template_preprocess_file_link()
 */
#}

<div{{ attributes }}><span>{{ link }}</span></div>
{% if file_size %}
 {# <span class="pdfIcon">&nbsp;</span><span class="filesize">({{ file_size }})</span> #}
<img class="pdf16" src="/files/inline-images/pdf-icon.png" alt="PDF that open in a new window" title="PDF that open in a new window" aria-label="PDF that open in a new window">&nbsp;<span class="filesize">({{ file_size }})</span>
{% endif %}
