# Copy these values into the deployment platform's secret/environment store.
# Drupal does not load this file automatically.
AVNL_DB_NAME=avnl
AVNL_DB_USER=avnl
AVNL_DB_PASSWORD=replace-with-a-secret
AVNL_DB_HOST=127.0.0.1
AVNL_DB_PORT=3306
# AVNL_DB_SOCKET=/path/to/mysql.sock

AVNL_HASH_SALT=replace-with-a-long-random-secret
AVNL_TRUSTED_HOST_PATTERNS=^www\.example\.gov\.in$,^example\.gov\.in$

AVNL_PUBLIC_FILES_PATH=files
AVNL_PRIVATE_FILES_PATH=/srv/avnl/private
AVNL_TEMP_PATH=/srv/avnl/tmp
AVNL_CONFIG_SYNC_DIR=/srv/avnl/config/sync
AVNL_TRANSLATIONS_PATH=/srv/avnl/translations
AVNL_ERROR_LEVEL=hide

# Preserve the target's existing SMTP values in its protected secret store.
AVNL_SMTP_USERNAME=replace-with-the-existing-username
AVNL_SMTP_PASSWORD=replace-with-the-existing-secret

# Preserve the target's existing Base64-encoded Drupal/TFA encryption key.
AVNL_ENCRYPTION_KEY=replace-with-the-existing-base64-key

# Optional alternative for in-place UAT upgrades: generated by
# scripts/preserve-uat-runtime.sh from the existing target. Do not place the
# generated PHP secrets file inside the release or commit it.
# AVNL_RUNTIME_SECRETS_FILE=/srv/avnl/private/avnl-runtime-secrets.php
